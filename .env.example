# ==============================================================================
# NexaThink AI Medical Assistant - Environment Template (.env.example)
# Copy this file to .env and fill in your production credentials
# ==============================================================================

# --- Generative AI & Clinical Guidance (Groq API) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Flask Web Server Configuration ---
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_SECRET_KEY=generate_a_secure_random_key_here
HOST=0.0.0.0
PORT=5000

# --- Model & File Storage Paths ---
CLASSIFIER_MODEL_PATH=pneumonia_resnet_best_model_1.h5
SUB_CLASSIFIER_MODEL_PATH=bacteria_vs_viral_resnet_best_model_2nd_attempt.h5
MODEL_DOWNLOAD_URL=https://github.com/AryanP03/Pneumonia-Disease-Prediction-and-Anomaly-Detection-Using-X-ray-Images/releases/download/v1.0.0/pneumonia_resnet_best_model_1.h5
UPLOAD_FOLDER=app/uploads
MAX_CONTENT_LENGTH=16777216

# --- CORS & Network Security ---
CORS_ORIGINS=*
